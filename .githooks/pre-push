#!/bin/sh
# Asks two confirmations before every push

echo "" >&2
echo "==================================================" >&2
echo " RECUERDA: avisa al equipo de lo que has cambiado." >&2
echo " Vas a mover, renombrar o borrar ficheros? Pregunta antes." >&2
echo " Deja que tus companeros hagan su parte: no lo hagas todo tu solo." >&2
echo "==================================================" >&2
echo "" >&2

# Without an interactive terminal (e.g. VS Code Sync button) the push is not blocked
if ! (exec < /dev/tty) 2>/dev/null; then
  echo "Push sin terminal: confirma los cambios con el equipo igualmente." >&2
  exit 0
fi

# Cancels the push unless the answer is Y
confirm() {
  printf "%s (Y/N): " "$1" >&2
  read answer < /dev/tty
  case "$answer" in
    [Yy]) ;;
    *) echo "Push cancelado. $2" >&2; exit 1 ;;
  esac
}

confirm "1/2 Has avisado al equipo de tus cambios?" "Avisa al equipo y vuelve a intentarlo."
confirm "2/2 Has dejado a tus companeros su parte del trabajo?" "Reparte las tareas con el equipo y vuelve a intentarlo."

echo "Push confirmado." >&2
exit 0